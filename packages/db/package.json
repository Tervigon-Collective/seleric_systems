{
  "name": "@multiagent/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -e ../../.env.local -- prisma migrate dev",
    "studio": "dotenv -e ../../.env -e ../../.env.local -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.18.0",
    "typescript": "^5.5.0"
  }
}
